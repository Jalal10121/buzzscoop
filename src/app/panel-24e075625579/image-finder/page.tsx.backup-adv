"use client";
import { useState, useEffect } from "react";

const SOURCES = [
  {
    name: "Unsplash",
    icon: "📸",
    color: "bg-black text-white",
    searchTemplate: "https://unsplash.com/s/photos/{q}",
    downloadUrlTemplate: null,
    best: "High-quality real photos",
    license: "Free, no attribution",
  },
  {
    name: "Pexels",
    icon: "🎬",
    color: "bg-teal-600 text-white",
    searchTemplate: "https://www.pexels.com/search/{q}/",
    downloadUrlTemplate: null,
    best: "Lifestyle, trending",
    license: "Free, no attribution",
  },
  {
    name: "Pixabay",
    icon: "🖼️",
    color: "bg-green-600 text-white",
    searchTemplate: "https://pixabay.com/images/search/{q}/",
    downloadUrlTemplate: null,
    best: "General content",
    license: "Free, no attribution",
  },
  {
    name: "Bing Image Creator",
    icon: "🤖",
    color: "bg-blue-600 text-white",
    searchTemplate: "https://www.bing.com/images/create?q={q}",
    downloadUrlTemplate: null,
    best: "AI generated (DALL-E 3)",
    license: "Free to use",
  },
  {
    name: "Leonardo AI",
    icon: "🎨",
    color: "bg-purple-600 text-white",
    searchTemplate: "https://app.leonardo.ai/ai-generations?prompt={q}",
    downloadUrlTemplate: null,
