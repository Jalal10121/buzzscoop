          </div>
        </aside>
      </div>

      {/* PREVIEW MODAL WITH SEO PANEL */}
      {showPreview && (
        <div className="fixed inset-0 bg-black/70 z-50 flex items-start justify-center p-4 overflow-y-auto" onClick={() => setShowPreview(false)}>
          <div className="bg-white rounded-xl max-w-5xl w-full my-8" onClick={e => e.stopPropagation()}>
