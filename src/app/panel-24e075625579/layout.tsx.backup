"use client";
import Link from "next/link";
import { usePathname, useRouter } from "next/navigation";
import { useState, useEffect } from "react";

const NAV = [
  { href: "/panel-24e075625579/dashboard", label: "Dashboard", icon: "📊" },
  { href: "/panel-24e075625579/articles", label: "Articles", icon: "📝" },
  { href: "/panel-24e075625579/articles/new", label: "New Article", icon: "➕" },
  { href: "/panel-24e075625579/ai-writer", label: "AI Writer", icon: "✨" },
  { href: "/panel-24e075625579/auto-queue", label: "Auto Queue", icon: "🤖" },
  { href: "/panel-24e075625579/trends", label: "Trends", icon: "📈" },
  { href: "/panel-24e075625579/media", label: "Media", icon: "🖼" },
  { href: "/panel-24e075625579/image-finder", label: "Image Finder", icon: "🎨" },
  { href: "/panel-24e075625579/image-sources", label: "Image Sources", icon: "🎨" },
  { href: "/panel-24e075625579/revisions", label: "Revisions", icon: "📜" },
  { href: "/panel-24e075625579/comments", label: "Comments", icon: "💬" },
  { href: "/panel-24e075625579/analytics", label: "Analytics", icon: "📈" },
  { href: "/panel-24e075625579/newsletter", label: "Newsletter", icon: "📬" },
  { href: "/panel-24e075625579/categories", label: "Categories", icon: "📁" },
  { href: "/panel-24e075625579/authors", label: "Authors", icon: "👤" },
  { href: "/panel-24e075625579/users", label: "Users", icon: "👥" },
  { href: "/panel-24e075625579/security", label: "Security", icon: "🛡" },
  { href: "/panel-24e075625579/backend", label: "Backend", icon: "🚀" },
  { href: "/panel-24e075625579/settings", label: "Settings", icon: "⚙" },
];

export default function AdminLayout({ children }: { children: React.ReactNode }) {
  const pathname = usePathname();
  const router = useRouter();
  const [open, setOpen] = useState(false);

  useEffect(() => {
    document.body.classList.add("admin-active");
    return () => document.body.classList.remove("admin-active");
  }, []);

  if (pathname.includes("/login")) return <>{children}</>;

  async function logout() {
    await fetch("/api/admin/logout", { method: "POST" });
    router.push("/panel-24e075625579/login");
  }

  return (
    <div className="min-h-screen bg-gray-100 flex">
      {open && <div className="fixed inset-0 bg-black/50 z-40 md:hidden" onClick={() => setOpen(false)} />}
      <aside className={`fixed md:sticky top-0 left-0 z-50 w-64 h-screen bg-gray-900 text-white flex flex-col transform transition-transform md:translate-x-0 ${open ? "translate-x-0" : "-translate-x-full"}`}>
        <div className="p-5 border-b border-gray-800 flex-shrink-0">
          <Link href="/panel-24e075625579/dashboard" className="text-xl font-black block">
            BUZZ<span className="text-yellow-500">SCOOP</span>
          </Link>
          <p className="text-xs text-gray-400 mt-1">Admin Panel</p>
        </div>
        <nav className="flex-1 overflow-y-auto p-3 space-y-1">
          {NAV.map(item => (
            <Link key={item.href} href={item.href} onClick={() => setOpen(false)}
              className={`flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium ${pathname === item.href ? "bg-yellow-400 text-black" : "text-gray-300 hover:bg-gray-800"}`}>
              <span>{item.icon}</span><span>{item.label}</span>
            </Link>
          ))}
        </nav>
        <div className="p-4 border-t border-gray-800 flex-shrink-0">
          <Link href="/" target="_blank" className="block text-center text-xs text-gray-400 hover:text-yellow-400 mb-2">← View Site</Link>
          <button onClick={logout} className="w-full text-center text-xs text-red-400">Logout</button>
        </div>
      </aside>
      <main className="flex-1 min-w-0">
        <div className="md:hidden sticky top-0 z-30 bg-white border-b px-3 py-2 flex items-center gap-2">
          <button onClick={() => setOpen(true)} className="w-10 h-10 flex items-center justify-center text-xl">☰</button>
          <Link href="/panel-24e075625579/dashboard" className="font-black">BUZZ<span className="text-yellow-500">SCOOP</span></Link>
        </div>
        <div className="max-w-6xl mx-auto p-4 sm:p-6 lg:p-8">{children}</div>
      </main>
    </div>
  );
}