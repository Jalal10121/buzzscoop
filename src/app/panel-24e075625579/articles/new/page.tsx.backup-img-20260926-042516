              <h2 className="font-black text-lg">Article Preview + SEO Analysis</h2>
              <button onClick={() => setShowPreview(false)} className="text-gray-400 hover:text-black text-xl">✕</button>
            </div>

            <div className="grid grid-cols-1 lg:grid-cols-3 gap-0">
              {/* LEFT: Article preview */}
              <article className="lg:col-span-2 p-6 sm:p-8 border-r">
                <div className="text-xs text-gray-500 mb-4">Home / {form.category} / {form.title || "Untitled"}</div>
                <span className="text-xs font-bold text-yellow-600 uppercase tracking-wide">{form.category}</span>
                <h1 className="text-3xl sm:text-4xl font-bold leading-tight mt-2 mb-3">
                  {form.title || "Your Title Here"}
