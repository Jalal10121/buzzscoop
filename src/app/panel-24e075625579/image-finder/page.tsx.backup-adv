    license: "Free tier",
  },
  {
    name: "Netflix Tudum",
    icon: "🎥",
    color: "bg-red-600 text-white",
    searchTemplate: "https://www.netflix.com/tudum",
    downloadUrlTemplate: null,
    best: "Netflix press images",
    license: "Press use only",
  },
  {
    name: "Google Images",
    icon: "🔍",
    color: "bg-gray-700 text-white",
    searchTemplate: "https://www.google.com/search?tbm=isch&q={q}",
    downloadUrlTemplate: null,
    best: "Reference / backup",
    license: "Check original",
  },
  {
    name: "Pinterest",
    icon: "📌",
    color: "bg-red-500 text-white",
    searchTemplate: "https://pinterest.com/search/pins/?q={q}",
    downloadUrlTemplate: null,
    best: "Trending visuals",
    license: "Check original",
  },
];

const AI_PROMPTS = [
  {
    key: "netflix",
    label: "🎬 Netflix Style",
    prompt: "Cinematic Netflix promotional poster, dark moody atmosphere, dramatic red lighting, streaming service thumbnail, professional editorial quality, 16:9 aspect ratio, no text, no logos, no faces",
  },
  {
    key: "hollywood",
    label: "🌟 Hollywood",
    prompt: "Hollywood red carpet event, paparazzi flash lighting, glamorous atmosphere, cinematic wide shot, professional photography, anonymous silhouettes, no faces, no text, 16:9",
  },
  {
    key: "thriller",
    label: "🔥 Thriller",
    prompt: "Dark thriller movie poster style, mysterious atmosphere, dramatic shadows, cinematic composition, moody blue and red lighting, no faces, no text, 16:9 aspect ratio",
  },
  {
    key: "romance",
    label: "💕 Romance",
    prompt: "Romantic cinematic scene, warm golden hour lighting, soft bokeh background, editorial magazine quality, no faces, no text, 16:9 aspect ratio",
  },
  {
    key: "music",
    label: "🎵 Music",
    prompt: "Concert stage dramatic lighting, atmospheric smoke effects, cinematic music performance scene, professional photography, silhouettes, no faces, no text, 16:9",
  },
  {
    key: "action",
    label: "⚡ Action",
    prompt: "Action movie cinematic poster, dynamic dramatic lighting, explosive atmosphere, thriller mood, editorial quality, 16:9 aspect ratio, no text, no faces",
  },
  {
    key: "sci-fi",
    label: "🚀 Sci-Fi",
    prompt: "Sci-fi cinematic promotional image, futuristic atmosphere, dramatic neon lighting, professional editorial quality, no text, no logos, 16:9 aspect ratio",
  },
  {
    key: "drama",
    label: "🎭 Drama",
    prompt: "Dramatic cinematic scene, moody atmosphere, warm and cool color contrast, editorial magazine quality, no faces, no text, 16:9 aspect ratio",
  },
];

export default function ImageFinder() {
  const [query, setQuery] = useState("");
  const [copied, setCopied] = useState<string | null>(null);
  const [recent, setRecent] = useState<string[]>([]);

  // Load recent searches
  useEffect(() => {
    try {
      const r = JSON.parse(localStorage.getItem("buzzscoop-image-searches") || "[]");
      setRecent(r);
    } catch {}
  }, []);

  function addRecent(term: string) {
    const updated = [term, ...recent.filter(r => r !== term)].slice(0, 8);
    setRecent(updated);
    localStorage.setItem("buzzscoop-image-searches", JSON.stringify(updated));
  }

  function openSource(source: any) {
    const term = (query.trim() || "netflix trending").slice(0, 100);
    addRecent(term);
    const url = source.searchTemplate.replace("{q}", encodeURIComponent(term));
    window.open(url, "_blank", "noopener");
  }

  function copy(text: string, label: string) {
    navigator.clipboard.writeText(text);
    setCopied(label);
    setTimeout(() => setCopied(null), 2000);
  }

  // Generate URL with current query
  function buildSearchUrl(template: string) {
    const term = query.trim() || "netflix";
    return template.replace("{q}", encodeURIComponent(term));
  }

  return (
    <div>
      <div className="mb-8">
        <h1 className="text-3xl font-black">🎨 Image Finder</h1>
        <p className="text-gray-500 text-sm mt-1">
          8 free image sources — no API, no cost, unlimited searches
        </p>
      </div>

      {/* Search Box */}
      <div className="bg-white rounded-xl border-2 border-yellow-300 p-6 mb-6">
        <label className="block text-sm font-bold mb-2">🔍 What image do you need?</label>
        <div className="flex gap-2">
          <input
            type="text"
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder="e.g., Netflix Wednesday Season 3"
            className="flex-1 px-4 py-3 border-2 rounded-lg text-lg font-medium focus:border-yellow-400 focus:outline-none"
            onKeyDown={(e) => {
              if (e.key === "Enter") openSource(SOURCES[0]);
            }}
          />
          <button
            onClick={() => openSource(SOURCES[0])}
            className="bg-yellow-400 hover:bg-yellow-500 text-black font-bold px-6 py-3 rounded-lg"
          >
            🔍 Search
          </button>
        </div>
        <p className="text-xs text-gray-500 mt-2">
          Type → press Enter or click any source below
        </p>

        {/* Recent searches */}
        {recent.length > 0 && (
          <div className="mt-4">
            <p className="text-xs font-bold text-gray-500 mb-2">🕐 Recent:</p>
            <div className="flex flex-wrap gap-2">
              {recent.map((r, i) => (
                <button
                  key={i}
                  onClick={() => setQuery(r)}
                  className="text-xs bg-gray-100 hover:bg-yellow-100 px-3 py-1 rounded-full font-medium"
                >
                  {r}
                </button>
              ))}
            </div>
          </div>
        )}
      </div>

      {/* Quick access grid */}
      <h2 className="font-black text-xl mb-4">🎯 Click to Search on Any Source</h2>
      <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-8">
        {SOURCES.map((s) => (
          <button
            key={s.name}
            onClick={() => openSource(s)}
            className="text-left bg-white rounded-xl border-2 border-gray-200 hover:border-yellow-400 hover:shadow-lg transition p-4 group"
          >
            <div className={`${s.color} rounded-lg p-3 flex items-center gap-2 mb-3`}>
              <span className="text-3xl">{s.icon}</span>
              <div>
                <div className="font-black text-sm">{s.name}</div>
                <div className="text-xs opacity-80">{s.license}</div>
              </div>
            </div>
            <p className="text-xs text-gray-600 mb-2">{s.best}</p>
            {query && (
              <div className="text-xs text-yellow-600 font-bold truncate group-hover:underline">
                🔍 "{query}" →
              </div>
            )}
          </button>
        ))}
      </div>

      {/* AI Prompts */}
      <div className="bg-gradient-to-br from-purple-50 to-pink-50 border-2 border-purple-200 rounded-xl p-6 mb-6">
        <h2 className="font-black text-xl text-purple-900 mb-2">🤖 AI Image Prompts</h2>
        <p className="text-sm text-purple-700 mb-4">
          Copy a prompt → Paste in <a href="https://www.bing.com/images/create" target="_blank" rel="noopener noreferrer" className="underline font-bold">Bing Image Creator</a> (free) or <a href="https://leonardo.ai" target="_blank" rel="noopener noreferrer" className="underline font-bold">Leonardo AI</a> → Generate → Download → Upload
        </p>

        <div className="grid gap-3 sm:grid-cols-2">
          {AI_PROMPTS.map((p) => (
            <div key={p.key} className="bg-white rounded-lg border border-purple-200 p-3">
              <div className="flex items-center justify-between mb-2">
                <span className="font-bold text-sm text-purple-900">{p.label}</span>
                <button
                  onClick={() => copy(p.prompt, p.key)}
                  className="text-xs bg-purple-500 hover:bg-purple-600 text-white font-bold px-3 py-1 rounded"
                >
                  {copied === p.key ? "✅ Copied!" : "📋 Copy"}
                </button>
              </div>
              <p className="text-xs text-gray-600 line-clamp-3">{p.prompt}</p>
            </div>
          ))}
        </div>
      </div>

      {/* How to use */}
      <div className="bg-blue-50 border border-blue-200 rounded-xl p-6">
        <h2 className="font-black text-blue-900 mb-4">📖 How to Use</h2>
        <ol className="space-y-3 text-sm text-blue-800">
          <li className="flex gap-3">
            <span className="font-black text-blue-900 bg-blue-200 w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0">1</span>
            <div>
              <strong>Type your topic</strong> in the search box above
            </div>
          </li>
          <li className="flex gap-3">
            <span className="font-black text-blue-900 bg-blue-200 w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0">2</span>
            <div>
              <strong>Click any source card</strong> — opens in new tab with your search
            </div>
          </li>
          <li className="flex gap-3">
            <span className="font-black text-blue-900 bg-blue-200 w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0">3</span>
            <div>
              <strong>Right-click any image</strong> → "Copy Image Address"
            </div>
          </li>
          <li className="flex gap-3">
            <span className="font-black text-blue-900 bg-blue-200 w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0">4</span>
            <div>
              <strong>Go to New Article</strong> → Paste in "Featured Image" field
            </div>
          </li>
          <li className="flex gap-3">
            <span className="font-black text-blue-900 bg-blue-200 w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0">5</span>
            <div>
              <strong>OR use AI prompts</strong> — copy → paste in Bing → download → upload
            </div>
          </li>
        </ol>
      </div>
    </div>
  );
}