          <button onClick={() => setShowPreview(true)} className="bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold px-5 py-2.5 rounded-lg">
            👁️ Preview
          </button>
          <button onClick={save} disabled={saving} className="bg-yellow-400 hover:bg-yellow-500 disabled:opacity-50 text-black font-bold px-6 py-2.5 rounded-lg">
            {saving ? "Saving..." : "🚀 Publish"}
          </button>
        </div>
      </div>

      {/* LIVE SCORES BAR */}
      <div className="grid gap-4 sm:grid-cols-2 mb-6">
        <div className={`rounded-xl border-2 p-4 ${scoreBg(seo.score)}`}>
          <div className="flex items-center justify-between mb-2">
            <span className="text-sm font-bold">📊 SEO Score</span>
            <span className={`text-2xl font-black ${scoreColor(seo.score)}`}>{seo.score}/100</span>
          </div>
          <div className="w-full bg-white/50 rounded-full h-2">
            <div className={`h-2 rounded-full transition-all ${seo.score >= 80 ? "bg-green-500" : seo.score >= 60 ? "bg-yellow-500" : "bg-red-500"}`} style={{ width: seo.score + "%" }}></div>
          </div>
        </div>

        <div className={`rounded-xl border-2 p-4 ${scoreBg(human.score)}`}>
          <div className="flex items-center justify-between mb-2">
            <span className="text-sm font-bold">✍️ Human-Write Score</span>
            <span className={`text-2xl font-black ${scoreColor(human.score)}`}>{human.score}/100</span>
          </div>
          <div className="w-full bg-white/50 rounded-full h-2">
            <div className={`h-2 rounded-full transition-all ${human.score >= 80 ? "bg-green-500" : human.score >= 60 ? "bg-yellow-500" : "bg-red-500"}`} style={{ width: human.score + "%" }}></div>
          </div>
        </div>
      </div>

      <div className="grid gap-6 lg:grid-cols-3">
        <div className="lg:col-span-2 space-y-4">
          <div className="bg-white rounded-xl border p-6 space-y-4">
