"use client";
import { useState, useMemo } from "react";
import { useRouter } from "next/navigation";

const CATS = ["Netflix", "Hollywood", "Marvel", "Music", "Streaming", "TV", "Awards", "Celebrity"];

// SEO Score Calculator
function calculateSEO(form: any) {
  const checks: { label: string; pass: boolean; hint: string; weight: number }[] = [];

  // Title length
  checks.push({
    label: "Title length (50-65 chars)",
    pass: form.title.length >= 50 && form.title.length <= 65,
    hint: `Current: ${form.title.length} chars`,
    weight: 15,
  });

  // Description length
  checks.push({
    label: "Description (150-160 chars)",
    pass: form.description.length >= 150 && form.description.length <= 160,
    hint: `Current: ${form.description.length} chars`,
    weight: 15,
  });

  // Content length
  const words = form.content.trim().split(/\s+/).filter(Boolean).length;
  checks.push({
    label: "Content length (800+ words)",
    pass: words >= 800,
    hint: `Current: ${words} words`,
    weight: 20,
  });

  // Keyword in title
  const kw = form.keyword.toLowerCase().trim();
  checks.push({
    label: "Keyword in title",
    pass: kw && form.title.toLowerCase().includes(kw),
    hint: kw ? "Check if keyword appears in title" : "Set keyword first",
    weight: 15,
  });

  // Keyword in description
  checks.push({
    label: "Keyword in description",
    pass: kw && form.description.toLowerCase().includes(kw),
    hint: kw ? "Check if keyword appears in description" : "Set keyword first",
    weight: 10,
  });

  // Headings (H2)
  checks.push({
    label: "Has H2 headings (##)",
    pass: form.content.includes("##"),
    hint: "Add ## headings for structure",
    weight: 10,
  });

  // Has image
  checks.push({
    label: "Featured image set",
    pass: !!form.image,
    hint: form.image ? "Image set ✓" : "Add image URL",
    weight: 10,
  });

  // Has hashtags
  checks.push({
    label: "Hashtags added (5+)",
    pass: form.hashtags.split(",").filter((t: string) => t.trim()).length >= 5,
    hint: `Count: ${form.hashtags.split(",").filter((t: string) => t.trim()).length}`,
    weight: 3,
  });

  // Has tags
  checks.push({
    label: "Tags added (3+)",
    pass: form.tags.split(",").filter((t: string) => t.trim()).length >= 3,
    hint: `Count: ${form.tags.split(",").filter((t: string) => t.trim()).length}`,
    weight: 2,
  });

  const total = checks.reduce((sum, c) => sum + (c.pass ? c.weight : 0), 0);
  const max = checks.reduce((sum, c) => sum + c.weight, 0);
  const score = Math.round((total / max) * 100);

  return { score, checks };
}

// Human Write Check
function calculateHumanScore(form: any) {
  const content = form.content || "";
  const signals: { label: string; human: boolean; hint: string }[] = [];

  const words = content.trim().split(/\s+/).filter(Boolean);
  const sentences = content.split(/[.!?]+/).filter(s => s.trim().length > 0);
  const paragraphs = content.split(/\n\n+/).filter(p => p.trim().length > 0);

  // Sentence length variety
  const avgSentLen = sentences.length > 0 ? words.length / sentences.length : 0;
  signals.push({
    label: "Sentence length varies",
    human: avgSentLen > 10 && avgSentLen < 25,
    hint: `Avg: ${Math.round(avgSentLen)} words/sentence`,
  });

  // Paragraph count
  signals.push({
    label: "Multiple paragraphs (5+)",
    human: paragraphs.length >= 5,
    hint: `${paragraphs.length} paragraphs`,
  });

  // Has questions (human engagement)
  signals.push({
    label: "Includes questions",
    human: content.includes("?"),
    hint: content.includes("?") ? "Has questions ✓" : "Add rhetorical questions",
  });

  // Has quotes
  signals.push({
    label: "Includes quotes",
    human: content.includes('"') || content.includes(">"),
    hint: content.includes('"') || content.includes(">") ? "Has quotes ✓" : "Add quotes for credibility",
  });

  // AI clichés check
  const aiClichés = ["delve", "tapestry", "testament", "in conclusion", "it's worth noting", "navigating", "landscape of", "realm of"];
  const foundClichés = aiClichés.filter(c => content.toLowerCase().includes(c));
  signals.push({
    label: "No AI clichés",
    human: foundClichés.length === 0,
    hint: foundClichés.length === 0 ? "Clean ✓" : `Found: ${foundClichés.join(", ")}`,
  });

  // Contractions (human writing)
  const contractions = ["don't", "can't", "won't", "it's", "you're", "they're", "we're", "isn't", "aren't"];
  const foundContractions = contractions.filter(c => content.toLowerCase().includes(c));
  signals.push({
    label: "Uses contractions",
    human: foundContractions.length >= 2,
    hint: `${foundContractions.length} contractions`,
  });

  // Has bullet points
  signals.push({
    label: "Has bullet points",
    human: content.includes("- ") || content.includes("* "),
    hint: content.includes("- ") || content.includes("* ") ? "Has bullets ✓" : "Add bullet lists",
  });

  const humanCount = signals.filter(s => s.human).length;
  const score = Math.round((humanCount / signals.length) * 100);

  return { score, signals };
}

export default function NewArticle() {
