"use client";
import { useState } from "react";
import { useRouter } from "next/navigation";

const CATS = ["Netflix", "Hollywood", "Marvel", "Music", "Streaming", "TV", "Awards", "Celebrity"];

export default function NewArticle() {
  const router = useRouter();
  const [saving, setSaving] = useState(false);
  const [showPreview, setShowPreview] = useState(false);
  const [form, setForm] = useState({ title: "", slug: "", description: "", content: "", image: "", category: "Netflix", author: "BuzzScoop Team", date: new Date().toISOString().split("T")[0], tags: "" });

  function update(k: string, v: string) {
    setForm(f => ({ ...f, [k]: v }));
    if (k === "title") setForm(f => ({ ...f, slug: v.toLowerCase().replace(/[^\w\s-]/g, "").replace(/\s+/g, "-") }));
  }

  async function save() {
    if (!form.title || !form.content) return alert("Title and content required");
    setSaving(true);
    const res = await fetch("/api/admin/articles", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ ...form, tags: form.tags.split(",").map(t => t.trim()).filter(Boolean) }) });
    if (res.ok) router.push("/panel-24e075625579/articles");
    else { alert("Save failed"); setSaving(false); }
  }

  return (
    <div>
      <div className="flex items-center justify-between mb-8 flex-wrap gap-3">
        <h1 className="text-3xl font-black">New Article</h1>
        <div className="flex gap-2">
          <button onClick={() => setShowPreview(true)} className="bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold px-5 py-2.5 rounded-lg">
            👁️ Preview
          </button>
          <button onClick={save} disabled={saving} className="bg-yellow-400 hover:bg-yellow-500 disabled:opacity-50 text-black font-bold px-6 py-2.5 rounded-lg">
            {saving ? "Saving..." : "🚀 Publish"}
          </button>
        </div>
      </div>

      <div className="grid gap-6 lg:grid-cols-3">
        <div className="lg:col-span-2 space-y-4">
          <div className="bg-white rounded-xl border p-6 space-y-4">
            <input type="text" value={form.title} onChange={e => update("title", e.target.value)} placeholder="Title" className="w-full px-4 py-3 border rounded-lg text-lg font-bold" />
            <input type="text" value={form.slug} onChange={e => update("slug", e.target.value)} placeholder="url-slug" className="w-full px-4 py-2 border rounded-lg text-sm font-mono" />
            <textarea value={form.description} onChange={e => update("description", e.target.value)} rows={3} maxLength={160} placeholder="SEO description" className="w-full px-4 py-3 border rounded-lg text-sm" />
            <p className="text-xs text-gray-400">{form.description.length}/160</p>
          </div>
          <div className="bg-white rounded-xl border p-6">
            <textarea value={form.content} onChange={e => update("content", e.target.value)} rows={20} className="w-full px-4 py-3 border rounded-lg font-mono text-sm" placeholder="Content (Markdown)..." />
          </div>
        </div>
        <aside className="space-y-4">
          <div className="bg-white rounded-xl border p-6 space-y-4">
            <select value={form.category} onChange={e => update("category", e.target.value)} className="w-full px-4 py-2 border rounded-lg">
              {CATS.map(c => <option key={c}>{c}</option>)}
            </select>
            <input type="text" value={form.author} onChange={e => update("author", e.target.value)} placeholder="Author" className="w-full px-4 py-2 border rounded-lg" />
            <input type="date" value={form.date} onChange={e => update("date", e.target.value)} className="w-full px-4 py-2 border rounded-lg" />
            <input type="text" value={form.tags} onChange={e => update("tags", e.target.value)} placeholder="tags, comma" className="w-full px-4 py-2 border rounded-lg text-sm" />
          </div>
        </aside>
      </div>

      {/* PREVIEW MODAL */}
      {showPreview && (
        <div className="fixed inset-0 bg-black/70 z-50 flex items-start justify-center p-4 overflow-y-auto" onClick={() => setShowPreview(false)}>
          <div className="bg-white rounded-xl max-w-3xl w-full my-8" onClick={e => e.stopPropagation()}>
            {/* Modal header */}
            <div className="sticky top-0 bg-white border-b px-6 py-4 flex items-center justify-between rounded-t-xl">
              <h2 className="font-black text-lg">Article Preview</h2>
              <div className="flex gap-2">
                <span className="text-xs bg-gray-100 px-2 py-1 rounded">Category: {form.category}</span>
                <button onClick={() => setShowPreview(false)} className="text-gray-400 hover:text-black text-xl w-8 h-8 flex items-center justify-center">✕</button>
              </div>
            </div>

            {/* Preview content — looks like public site */}
            <article className="p-6 sm:p-8">
              {/* Breadcrumb */}
              <div className="text-xs text-gray-500 mb-4">
                Home / {form.category} / {form.title || "Untitled"}
              </div>

              {/* Category badge */}
              <span className="text-xs font-bold text-yellow-600 uppercase tracking-wide">
                {form.category}
              </span>

              {/* Title */}
              <h1 className="text-3xl sm:text-4xl font-bold leading-tight mt-2 mb-3">
                {form.title || "Your Title Here"}
              </h1>

              {/* Meta */}
              <div className="flex items-center gap-3 text-sm text-gray-500 mb-6 flex-wrap">
                <span>By {form.author || "BuzzScoop Team"}</span>
                <span>•</span>
                <time>{new Date(form.date).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</time>
                <span>•</span>
                <span>{Math.max(1, Math.ceil(form.content.split(/\s+/).length / 200))} min read</span>
              </div>

              {/* Featured image placeholder */}
              <div className="relative aspect-video bg-gradient-to-br from-yellow-100 to-yellow-50 rounded-xl mb-6 flex items-center justify-center border-2 border-dashed border-yellow-300">
                <div className="text-center">
                  <div className="text-4xl mb-2">🖼️</div>
                  <p className="text-xs text-gray-500">Featured Image</p>
                  <p className="text-xs text-gray-400">(Upload in media library)</p>
                </div>
              </div>

              {/* Share buttons mockup */}
              <div className="flex gap-2 mb-6 py-3 border-y border-gray-200">
                <span className="text-xs font-bold text-gray-500 mr-2">Share:</span>
                <span className="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-xs">𝕏</span>
                <span className="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-xs">f</span>
                <span className="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-xs">💬</span>
              </div>

              {/* Content */}
              <div className="prose prose-lg max-w-none">
                {form.content ? (
                  <div className="whitespace-pre-wrap text-gray-800 leading-relaxed">{form.content}</div>
                ) : (
                  <p className="text-gray-400 italic">Your article content will appear here...</p>
                )}
              </div>

              {/* Description (SEO preview) */}
              {form.description && (
                <div className="mt-8 p-4 bg-blue-50 border border-blue-200 rounded-lg">
                  <p className="text-xs font-bold text-blue-900 mb-1">📊 SEO Preview (Google)</p>
                  <p className="text-blue-700 text-sm">buzzscoop.news › blog › {form.slug || "your-article"}</p>
                  <p className="text-blue-900 font-medium">{form.title}</p>
                  <p className="text-xs text-gray-600">{form.description}</p>
                </div>
              )}

              {/* Tags */}
              {form.tags && (
                <div className="mt-6 flex flex-wrap gap-2">
                  {form.tags.split(",").map((tag, i) => (
                    <span key={i} className="text-xs bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full">
                      #{tag.trim()}
                    </span>
                  ))}
                </div>
              )}
            </article>

            {/* Modal footer */}
            <div className="border-t px-6 py-4 flex justify-end gap-2">
              <button onClick={() => setShowPreview(false)} className="px-4 py-2 text-gray-600 hover:text-black">Close</button>
              <button onClick={() => { setShowPreview(false); save(); }} className="bg-yellow-400 hover:bg-yellow-500 text-black font-bold px-6 py-2 rounded-lg">
                🚀 Publish Now
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}